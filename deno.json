{
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite",
    "build": "deno run -A --node-modules-dir=auto npm:vite build",
    "serve": "deno task build && deno task server:start"
  },
  "imports": {
    "@/": "./src/",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "@reduxjs/toolkit": "npm:@reduxjs/toolkit@^2.11.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "@types/react": "npm:@types/react@^19.2.14",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.1",
    "clsx": "npm:clsx@^2.1.1",
    "prettier": "npm:prettier@^3.8.3",
    "pretty-ms": "npm:pretty-ms@^9.3.0",
    "react": "npm:react@^19.2.6",
    "react-dom": "npm:react-dom@^19.2.6",
    "react-hook-form": "npm:react-hook-form@^7.75.0",
    "react-icons": "npm:react-icons@^5.6.0",
    "react-redux": "npm:react-redux@^9.2.0",
    "react-router-dom": "npm:react-router-dom@^7.15.0",
    "react-select": "npm:react-select@^5.10.2",
    "react-select-async-paginate": "npm:react-select-async-paginate@^0.7.11",
    "react-toastify": "npm:react-toastify@^11.1.0",
    "standard-version": "npm:standard-version@^9.5.0",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "vite": "npm:vite@^8.0.12"
  },
  "compilerOptions": {
    "types": ["react", "react-dom", "@types/react"],
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
