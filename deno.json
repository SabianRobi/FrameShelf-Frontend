{
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite",
    "build": "deno run -A --node-modules-dir=auto npm:vite build",
    "serve": "deno task build && deno task server:start"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.0",
    "@reduxjs/toolkit": "npm:@reduxjs/toolkit@^2.6.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.3",
    "@types/react": "npm:@types/react@^18.3.12",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.3.3",
    "prettier": "npm:prettier@^3.5.3",
    "pretty-ms": "npm:pretty-ms@^9.2.0",
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-hook-form": "npm:react-hook-form@^7.55.0",
    "react-icons": "npm:react-icons@^5.5.0",
    "react-redux": "npm:react-redux@^9.2.0",
    "react-router-dom": "npm:react-router-dom@^7.5.0",
    "react-select": "npm:react-select@^5.10.1",
    "react-select-async-paginate": "npm:react-select-async-paginate@^0.7.9",
    "react-toastify": "npm:react-toastify@^11.0.5",
    "tailwindcss": "npm:tailwindcss@^4.1.3",
    "vite": "npm:vite@^5.4.11"
  },
  "compilerOptions": {
    "types": ["react", "react-dom", "@types/react"],
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
